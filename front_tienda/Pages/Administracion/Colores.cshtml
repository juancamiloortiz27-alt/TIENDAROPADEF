@page
@model front_tienda.Pages.Administracion.ColoresModel
@{
    ViewData["Title"] = "Colores";
}

<h1>Colores</h1>
@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-info">@Model.Mensaje</div>
}

<form method="post" class="col-md-6 mb-4">
    <input type="hidden" asp-for="Entidad.IdColor" />
    <label asp-for="Entidad.Nombre">Nombre</label>
    <input asp-for="Entidad.Nombre" class="form-control mb-2" maxlength="30" />
    <label asp-for="Entidad.CodigoHexadecimal">Selecciona el color</label>
    <div class="d-flex align-items-center gap-2 mb-2">
        <input asp-for="Entidad.CodigoHexadecimal" type="color" class="form-control form-control-color" title="Selecciona el color" />
        <span>El selector guarda automáticamente el código hexadecimal.</span>
    </div>
    <label asp-for="Entidad.Tipo">Tipo</label>
    <input asp-for="Entidad.Tipo" class="form-control mb-2" maxlength="20" />
    <label asp-for="Entidad.Descripcion">Descripción</label>
    <input asp-for="Entidad.Descripcion" class="form-control mb-3" maxlength="100" />
    @if (Model.Entidad.IdColor == 0)
    {
        <button class="btn btn-primary" asp-page-handler="Insertar">Insertar</button>
    }
    else
    {
        <button class="btn btn-primary" asp-page-handler="Actualizar">Actualizar</button>
    }
    <button class="btn btn-secondary" asp-page-handler="Limpiar">Limpiar</button>
</form>

<form method="post" class="mb-3">
    <div class="input-group col-md-6">
        <input asp-for="Filtro.Nombre" class="form-control" placeholder="Buscar color" />
        <button class="btn btn-outline-primary" asp-page-handler="Buscar">Buscar</button>
    </div>
</form>

<table class="table">
    <thead><tr><th>Color</th><th>Muestra</th><th>Código</th><th>Tipo</th><th>Descripción</th><th>Acciones</th></tr></thead>
    <tbody>
        @foreach (var color in Model.Lista)
        {
            <tr>
                <td>@color.Nombre</td>
                <td><span class="d-inline-block border rounded" style="width: 28px; height: 28px; background-color: @color.CodigoHexadecimal"></span></td>
                <td>@color.CodigoHexadecimal</td><td>@color.Tipo</td><td>@color.Descripcion</td>
                <td>
                    <form method="post" class="d-inline">
                        <input type="hidden" name="id" value="@color.IdColor" />
                        <button class="btn btn-sm btn-outline-primary" asp-page-handler="Seleccionar">Editar</button>
                    </form>
                    <form method="post" class="d-inline" onsubmit="return confirm('¿Quieres borrar este color?');">
                        <input type="hidden" name="id" value="@color.IdColor" />
                        <button class="btn btn-sm btn-outline-danger" asp-page-handler="Borrar">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
