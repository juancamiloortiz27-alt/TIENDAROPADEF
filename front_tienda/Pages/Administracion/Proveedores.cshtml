@page
@model front_tienda.Pages.Administracion.ProveedoresModel
@{
    ViewData["Title"] = "Proveedores";
}

<h1>Proveedores</h1>
@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-info">@Model.Mensaje</div>
}

<form method="post" class="col-md-6 mb-4">
    <input type="hidden" asp-for="Entidad.IdProveedor" />
    <label asp-for="Entidad.Nombre">Nombre</label>
    <input asp-for="Entidad.Nombre" class="form-control mb-2" maxlength="50" />
    <label asp-for="Entidad.Telefono">Teléfono</label>
    <input asp-for="Entidad.Telefono" class="form-control mb-2" maxlength="12" />
    <label asp-for="Entidad.Correo">Correo</label>
    <input asp-for="Entidad.Correo" type="email" class="form-control mb-2" maxlength="60" />
    <label asp-for="Entidad.Ciudad">Ciudad</label>
    <input asp-for="Entidad.Ciudad" class="form-control mb-3" maxlength="30" />
    @if (Model.Entidad.IdProveedor == 0)
    {
        <button class="btn btn-primary" asp-page-handler="Insertar">Insertar</button>
    }
    else
    {
        <button class="btn btn-primary" asp-page-handler="Actualizar">Actualizar</button>
    }
    <button class="btn btn-secondary" asp-page-handler="Limpiar">Limpiar</button>
</form>

<form method="post" class="mb-3">
    <div class="row g-2 col-md-8">
        <div class="col-md-3"><input asp-for="Filtro.Nombre" class="form-control" placeholder="Nombre" /></div>
        <div class="col-md-3"><input asp-for="Filtro.Correo" class="form-control" placeholder="Correo" /></div>
        <div class="col-md-3"><input asp-for="Filtro.Ciudad" class="form-control" placeholder="Ciudad" /></div>
        <div class="col-md-3"><button class="btn btn-outline-primary" asp-page-handler="Buscar">Buscar</button></div>
    </div>
</form>

<table class="table">
    <thead><tr><th>Nombre</th><th>Teléfono</th><th>Correo</th><th>Ciudad</th><th>Acciones</th></tr></thead>
    <tbody>
        @foreach (var proveedor in Model.Lista)
        {
            <tr>
                <td>@proveedor.Nombre</td><td>@proveedor.Telefono</td><td>@proveedor.Correo</td><td>@proveedor.Ciudad</td>
                <td>
                    <form method="post" class="d-inline">
                        <input type="hidden" name="id" value="@proveedor.IdProveedor" />
                        <button class="btn btn-sm btn-outline-primary" asp-page-handler="Seleccionar">Editar</button>
                    </form>
                    <form method="post" class="d-inline" onsubmit="return confirm('¿Quieres borrar este proveedor?');">
                        <input type="hidden" name="id" value="@proveedor.IdProveedor" />
                        <button class="btn btn-sm btn-outline-danger" asp-page-handler="Borrar">Borrar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
