<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tienda de ropa</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/front_tienda.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-light bg-white box-shadow mb-3 site-navbar">
            <div class="container site-header-container">
                @if (Context.Session.GetString("Rol") == "Administrador")
                {
                    <button class="btn btn-outline-dark admin-menu-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuAdministrador" aria-controls="menuAdministrador" aria-label="Abrir menú de administración">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"/>
                        </svg>
                    </button>
                }
                else
                {
                    <button class="btn btn-outline-dark customer-menu-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuCliente" aria-controls="menuCliente" aria-label="Abrir menú de navegación">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"/>
                        </svg>
                    </button>
                }
                <a class="navbar-brand" asp-area="" asp-page="/Index">Tienda de ropa</a>
                @if (Context.Session.GetString("Rol") == "Administrador")
                {
                    <div class="d-flex align-items-center gap-3 ms-auto">
                        <span class="text-muted d-none d-md-inline">@Context.Session.GetString("Correo") (Administrador)</span>
                    </div>
                    <div class="offcanvas offcanvas-start admin-offcanvas" tabindex="-1" id="menuAdministrador" aria-labelledby="menuAdministradorTitulo">
                        <div class="offcanvas-header border-bottom">
                            <div>
                                <h5 class="offcanvas-title" id="menuAdministradorTitulo">Administración</h5>
                                <small class="text-muted">@Context.Session.GetString("Correo")</small>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
                        </div>
                        <div class="offcanvas-body">
                            <div class="admin-menu-section">
                                <div class="admin-menu-heading">Tienda</div>
                                <a class="admin-menu-link" asp-page="/Index">Inicio</a>
                                <a class="admin-menu-link" asp-page="/Ventanas/Categorias">Categorías</a>
                                <a class="admin-menu-link" asp-page="/Ventanas/Productos">Productos</a>
                                <a class="admin-menu-link" asp-page="/Ventanas/Marcas">Marcas</a>
                            </div>
                            <div class="admin-menu-section">
                                <div class="admin-menu-heading">Administrar</div>
                                <a class="admin-menu-link" asp-page="/Ventanas/Categorias" asp-route-gestionar="true">Gestionar categorías</a>
                                <a class="admin-menu-link" asp-page="/Administracion/Usuarios">Usuarios</a>
                                <a class="admin-menu-link" asp-page="/Administracion/Auditorias">Auditorías</a>
                                <a class="admin-menu-link" asp-page="/Administracion/Auditorias" asp-page-handler="DescargarExcel">Descargar auditorías (Excel)</a>
                                <a class="admin-menu-link" asp-page="/Administracion/Cupones">Cupones</a>
                                <a class="admin-menu-link" asp-page="/Administracion/MetodosPago">Métodos de pago</a>
                                <a class="admin-menu-link" asp-page="/Administracion/Marcas">Gestionar marcas</a>
                                <a class="admin-menu-link" asp-page="/Administracion/Colores">Colores</a>
                                <a class="admin-menu-link" asp-page="/Administracion/Tallas">Tallas</a>
                                <a class="admin-menu-link" asp-page="/Administracion/Proveedores">Proveedores</a>
                                <a class="admin-menu-link" asp-page="/Administracion/Transportadoras">Transportadoras</a>
                                <a class="admin-menu-link" asp-page="/Administracion/Envios">Envíos</a>
                                <a class="admin-menu-link" asp-page="/Administracion/Productos">Gestionar productos</a>
                                <a class="admin-menu-link" asp-page="/Administracion/Inventarios">Inventarios</a>
                            </div>
                        </div>
                        <div class="offcanvas-footer border-top p-3">
                            <form method="post" asp-page="/Cuenta/Acceso" asp-page-handler="Salir">
                                <button class="btn btn-outline-dark w-100">Cerrar sesión</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="offcanvas offcanvas-start customer-offcanvas" tabindex="-1" id="menuCliente" aria-labelledby="menuClienteTitulo">
                        <div class="offcanvas-header border-bottom">
                            <h5 class="offcanvas-title" id="menuClienteTitulo">Explorar la tienda</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
                        </div>
                        <div class="offcanvas-body">
                            <div class="admin-menu-section">
                                <div class="admin-menu-heading">Comprar</div>
                                <a class="admin-menu-link" asp-page="/Index">Inicio</a>
                                <a class="admin-menu-link" asp-page="/Ventanas/Categorias">Categorías</a>
                                <a class="admin-menu-link" asp-page="/Ventanas/Productos">Todos los productos</a>
                                <a class="admin-menu-link" asp-page="/Ventanas/Marcas">Marcas</a>
                            </div>
                            @if (Context.Session.GetString("Rol") == "Cliente")
                            {
                                <div class="admin-menu-section">
                                    <div class="admin-menu-heading">Mi cuenta</div>
                                    <a class="admin-menu-link" asp-page="/Cuenta/MiPerfil">Mi perfil</a>
                                    <a class="admin-menu-link" asp-page="/Ventanas/Direcciones">Mis direcciones</a>
                                    <a class="admin-menu-link" asp-page="/Ventanas/MisPedidos">Mis pedidos</a>
                                    <a class="admin-menu-link" asp-page="/Ventanas/MisPedidos" asp-page-handler="DescargarExcel">Descargar mis compras (Excel)</a>
                                    <a class="admin-menu-link" asp-page="/Ventanas/MisFavoritos">Favoritos</a>
                                    <a class="admin-menu-link" asp-page="/Ventanas/Carrito">Carrito</a>
                                </div>
                            }
                        </div>
                        @if (Context.Session.GetString("Rol") == "Cliente")
                        {
                            <div class="offcanvas-footer border-top p-3">
                                <form method="post" asp-page="/Cuenta/Acceso" asp-page-handler="Salir">
                                    <button class="btn btn-outline-dark w-100">Cerrar sesión</button>
                                </form>
                            </div>
                        }
                    </div>
                    <form method="get" asp-page="/Ventanas/Productos" class="customer-search">
                        <input class="form-control" type="search" name="nombre" placeholder="Buscar prendas" aria-label="Buscar productos por texto" />
                        <button class="btn customer-icon-button" type="submit" aria-label="Buscar">
                            <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.8" />
                                <path d="m16 16 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                            </svg>
                        </button>
                    </form>
                    <div class="customer-header-actions">
                        @if (Context.Session.GetString("Rol") == "Cliente")
                        {
                            <a class="btn customer-icon-button" asp-page="/Cuenta/MiPerfil" aria-label="Mi perfil" title="Mi perfil">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8" />
                                    <path d="M4 21c.6-4.1 3.4-6.2 8-6.2s7.4 2.1 8 6.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                </svg>
                            </a>
                            <a class="btn customer-icon-button" asp-page="/Ventanas/Carrito" aria-label="Carrito de compras" title="Carrito de compras">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M3 4h2l2.1 10.2a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 1.9-1.4L22 8H6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                    <circle cx="10" cy="20" r="1.2" fill="currentColor" />
                                    <circle cx="18" cy="20" r="1.2" fill="currentColor" />
                                </svg>
                            </a>
                        }
                        else if (!Context.Request.Path.StartsWithSegments("/Cuenta/Acceso") && !Context.Request.Path.StartsWithSegments("/Cuenta/Registro"))
                        {
                            <a class="btn customer-icon-button" asp-page="/Cuenta/Acceso" aria-label="Iniciar sesión" title="Iniciar sesión">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8" />
                                    <path d="M4 21c.6-4.1 3.4-6.2 8-6.2s7.4 2.1 8 6.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                </svg>
                            </a>
                            <a class="btn customer-icon-button" asp-page="/Cuenta/Acceso" asp-route-returnUrl="/Ventanas/Carrito" aria-label="Inicia sesión para ver el carrito" title="Carrito de compras">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M3 4h2l2.1 10.2a2 2 0 0 0 2 1.6h8.7a2 2 0 0 0 1.9-1.4L22 8H6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                                    <circle cx="10" cy="20" r="1.2" fill="currentColor" />
                                    <circle cx="18" cy="20" r="1.2" fill="currentColor" />
                                </svg>
                            </a>
                        }
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container site-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Tienda de ropa - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
