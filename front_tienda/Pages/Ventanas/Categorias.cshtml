@page
@model front_tienda.Pages.Ventanas.CategoriasModel
@{
    ViewData["Title"] = Model.VistaGestion ? "Gestionar categorías" : "Categorías";
}

<h1>@(Model.VistaGestion ? "Gestionar categorías" : "Categorías")</h1>
<p>@(Model.VistaGestion ? "Crea y administra las categorías de la tienda." : "Explora las categorías disponibles en nuestra tienda.")</p>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-info">@Model.Mensaje</div>
}

@if (Model.VistaGestion)
{
<form method="post" enctype="multipart/form-data" class="category-admin-form mb-4">
    <input type="hidden" name="Gestionar" value="true" />
    <input type="hidden" asp-for="Entidad.IdCategoria" />
    <input type="hidden" asp-for="Entidad.Imagen" />
    <div class="mb-2">
        <label asp-for="Entidad.Nombre">Nombre</label>
        <input asp-for="Entidad.Nombre" class="form-control" maxlength="30" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.Descripcion">Descripción</label>
        <input asp-for="Entidad.Descripcion" class="form-control" maxlength="100" />
    </div>
    <div class="mb-2">
        <label asp-for="Entidad.TipoRopa">Tipo de ropa</label>
        <input asp-for="Entidad.TipoRopa" class="form-control" maxlength="30" />
    </div>
    <div class="mb-3">
        <label asp-for="ArchivoImagen" class="form-label">Foto de la categoría</label>
        <input asp-for="ArchivoImagen" type="file" accept=".jpg,.jpeg,.jfif,.png,.webp,.gif,.bmp,.tif,.tiff,.avif" class="form-control" />
        <div class="form-text">Selecciona una imagen JPG, PNG, WEBP, GIF, BMP, TIFF o AVIF de máximo 5 MB.</div>
        @if (!string.IsNullOrWhiteSpace(Model.Entidad.Imagen))
        {
            <img src="@Model.Entidad.Imagen" alt="Foto de la categoría @Model.Entidad.Nombre" class="admin-image-preview mt-2" />
        }
    </div>
    <div class="form-check mb-3">
        <input asp-for="Entidad.Estado" class="form-check-input" />
        <label asp-for="Entidad.Estado" class="form-check-label">Activa</label>
    </div>
    @if (Model.Entidad.IdCategoria == 0)
    {
        <button type="submit" asp-page-handler="Insertar" class="btn btn-primary">Insertar</button>
    }
    else
    {
        <button type="submit" asp-page-handler="Actualizar" class="btn btn-primary">Actualizar</button>
    }
    <button type="submit" asp-page-handler="Limpiar" class="btn btn-secondary">Limpiar</button>
</form>
}

<form method="post" class="mb-4">
    <input type="hidden" name="Gestionar" value="@Model.Gestionar" />
    <div class="input-group">
        <input asp-for="TextoBusqueda" class="form-control" placeholder="Buscar por nombre" />
        <button type="submit" asp-page-handler="Buscar" class="btn btn-outline-primary">Buscar</button>
        <button type="submit" asp-page-handler="Consultar" class="btn btn-outline-secondary">Ver todas</button>
    </div>
</form>

@if (Model.Lista.Count == 0)
{
    <p>No se encontraron categorías.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 category-card-list">
        @foreach (var categoria in Model.Lista)
        {
            <div class="col">
                <article class="card h-100 category-card">
                    <a class="category-card-link" asp-page="/Ventanas/Productos" asp-route-categoria="@categoria.Nombre" aria-label="Ver productos de la categoría @categoria.Nombre">
                        @if (!string.IsNullOrWhiteSpace(categoria.Imagen))
                        {
                            <img src="@categoria.Imagen" alt="Foto de la categoría @categoria.Nombre" class="brand-page-image" />
                        }
                        else
                        {
                            <div class="category-image-placeholder">@categoria.Nombre</div>
                        }
                        <div class="card-body">
                            <h2 class="h5 card-title">@categoria.Nombre</h2>
                            <p class="card-text">@categoria.Descripcion</p>
                            <p class="card-text mb-0">Tipo de ropa: @categoria.TipoRopa</p>
                        </div>
                    </a>
                    @if (Model.VistaGestion)
                    {
                        <div class="card-footer bg-white border-0 d-flex gap-2">
                            <form method="post">
                                <input type="hidden" name="Gestionar" value="true" />
                                <input type="hidden" name="id" value="@categoria.IdCategoria" />
                                <button type="submit" asp-page-handler="Seleccionar" class="btn btn-sm btn-outline-primary">Editar</button>
                            </form>
                            <form method="post" onsubmit="return confirm('¿Estás seguro de que quieres borrar esta categoría?');">
                                <input type="hidden" name="Gestionar" value="true" />
                                <input type="hidden" name="id" value="@categoria.IdCategoria" />
                                <button type="submit" asp-page-handler="Borrar" class="btn btn-sm btn-outline-danger">Borrar</button>
                            </form>
                        </div>
                    }
                </article>
            </div>
        }
    </div>
}
